<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      CHỈ dành cho test, KHÔNG bao giờ tham chiếu từ Core hay Web: đây đúng phiên bản ClosedXML
      backend dùng để đọc file Excel lúc nhập danh sách (Lottery.Api.csproj). Test dùng nó để (1)
      dựng file .xlsx thật thay vì bịa XML, và (2) so từng ô với bộ đọc tự viết trong Core — bộ đọc
      tự viết là để bản WebAssembly khỏi phải cõng OpenXml + Irony, cái giá phải trả là chỗ này.
    -->
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Noxh.XacMinh.Core\Noxh.XacMinh.Core.csproj" />
    <ProjectReference Include="..\Noxh.XacMinh.TestSupport\Noxh.XacMinh.TestSupport.csproj" />
  </ItemGroup>

</Project>
