@page "/"
@using System.Text
@using Noxh.XacMinh.Core.Crypto
@using Noxh.XacMinh.Core.XuatKetQua
@inject TrangThaiDanhMuc danhMuc
@inject TrangThaiMocNeo mocNeo
@inject TrangThaiDanhSach danhSach
@inject TrangThaiKho kho

<PageTitle>Kiểm chứng kết quả bốc thăm NƠXH</PageTitle>

<h1>Kiểm chứng kết quả bốc thăm</h1>

<p class="dan-nhap">
    Thả vào đây file báo cáo minh bạch (JSON) tải từ trang công bố kết quả. Công cụ tự tính lại mã
    băm và nói cho bạn biết bản công bố có đúng bản đã niêm phong hay không.
    <strong>Dữ liệu của bạn không rời khỏi máy này.</strong>
</p>

<label class="o-tha-file">
    <InputFile OnChange="NhanFile" accept=".json,application/json" />
    <span>Bấm chọn hoặc kéo thả file JSON vào đây</span>
</label>

@* Không điều khiển thuộc tính open: để trình duyệt giữ trạng thái người dùng tự mở, kẻo bấm
   "Kiểm nội dung đã dán" xong ô văn bản lại tự cụp vào. *@
<details class="o-dan">
    <summary>Hoặc dán nội dung JSON</summary>
    <textarea @bind="noiDungDan" @bind:event="oninput" rows="6"
              placeholder="Dán toàn bộ nội dung file JSON vào đây"></textarea>
    <button type="button" @onclick="KiemNoiDungDan" disabled="@string.IsNullOrWhiteSpace(noiDungDan)">
        Kiểm nội dung đã dán
    </button>
</details>

@if (loi is not null)
{
    <div class="thong-bao-loi" role="alert">@loi</div>
}

@if (baoCao is not null)
{
    <KetQuaKiem BaoCao="baoCao" Nguon="@nguon" ThongTinXuat="thongTinXuat" />
    <MocNeoChuoiKhoi DaDoi="KiemLaiBaoCaoDaNap" />
    <DanhSachHoSo DaDoi="KiemLaiBaoCaoDaNap" />
    <TrailBangChung DaDoi="KiemLaiBaoCaoDaNap" />
    <KhungLuoiPhieu BaoCao="nguonBaoCao" DanhMuc="danhMuc.DanhMuc" />
}

@* Danh mục căn là dữ liệu công cụ tự mang theo, không đến từ file người dùng thả vào — nên hiện
   sẵn kể cả khi chưa nạp báo cáo nào. Đổi danh mục thì kiểm lại: vòng phân căn ưu tiên dựng lại từ
   chính nó, để kết luận cũ đứng yên là nói dối. *@
<DanhMucCan DaDoi="KiemLaiBaoCaoDaNap" />

@code {
    // 64 MB: báo cáo của một dự án ~900 vé chỉ vài MB; giới hạn để file nhầm không treo tab.
    private const long GioiHanByte = 64L * 1024 * 1024;

    private string noiDungDan = string.Empty;
    private string? loi;
    private string? nguon;
    private VerificationReport? baoCao;

    // Lưới ô phiếu vẽ từ chính báo cáo đã nạp — giữ lại để khỏi phải đọc file lần nữa.
    private TransparencyReport? nguonBaoCao;

    // Mã băm trên đúng byte người dùng thả vào, để bản xuất kết quả nói được "đã kiểm cái gì" —
    // người thứ ba đối chiếu bằng `sha256sum` trên chính file họ tải, không phải tin lời công cụ.
    private string maBamDauVao = string.Empty;
    private string tenFileDauVao = string.Empty;
    private ThongTinBanXuat? thongTinXuat;

    private async Task NhanFile(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(GioiHanByte);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var byteGoc = buffer.ToArray();
            Kiem(Encoding.UTF8.GetString(byteGoc), file.Name, byteGoc);
        }
        catch (Exception ex)
        {
            // Đọc file hỏng/quá lớn không được làm trắng trang.
            XoaKetQua();
            loi = $"Không đọc được file: {ex.Message}";
        }
    }

    private void KiemNoiDungDan() =>
        Kiem(noiDungDan, "nội dung đã dán", Encoding.UTF8.GetBytes(noiDungDan));

    private void Kiem(string json, string tenNguon, byte[] byteGoc)
    {
        var nap = TransparencyJson.Parse(json);
        if (!nap.Success)
        {
            XoaKetQua();
            loi = nap.ErrorMessage;
            return;
        }

        loi = null;
        nguon = TenNguon(nap.Report!, tenNguon);
        nguonBaoCao = nap.Report!;
        tenFileDauVao = tenNguon;
        maBamDauVao = Hex.Sha256Hex(byteGoc);
        // Báo cáo mới ⇒ block đã tra cứu và trail đã đọc của báo cáo trước không được dùng lại, và
        // bảng danh sách + khoá của việc đã xong không được nằm lại trong bộ nhớ.
        mocNeo.DatBaoCao(nap.Report!);
        danhSach.Xoa();
        kho.Xoa();
        KiemLaiBaoCaoDaNap();
    }

    private void KiemLaiBaoCaoDaNap()
    {
        if (nguonBaoCao is null) return;

        baoCao = Verifier.Verify(DuLieuVaoLoi(nguonBaoCao));
        // Kiểm lại là một lần kiểm mới (đổi danh mục, đọc thêm trail) — bản xuất phải mang thời
        // điểm và đầu vào của chính lần này.
        thongTinXuat = new ThongTinBanXuat(
            DateTimeOffset.UtcNow, PhienBanCongCu.HienTai, LietKeDauVao(), nguon);
    }

    private void XoaKetQua()
    {
        baoCao = null;
        nguonBaoCao = null;
        thongTinXuat = null;
        maBamDauVao = string.Empty;
        tenFileDauVao = string.Empty;
        mocNeo.DatBaoCao(null);
    }

    /// <summary>Mọi thứ đã đi vào lần kiểm này và đổi được kết luận — danh mục căn cũng là đầu vào.</summary>
    private IReadOnlyList<DauVaoDaKiem> LietKeDauVao()
    {
        var dauVao = new List<DauVaoDaKiem>
        {
            new($"Báo cáo minh bạch ({tenFileDauVao})", maBamDauVao),
            new(
                danhMuc.Nguon == NguonDanhMuc.Nhung
                    ? "Danh mục căn (bản nhúng sẵn trong công cụ)"
                    : $"Danh mục căn ({danhMuc.TenFile})",
                danhMuc.DanhMuc.Sha256),
        };

        // Trail nạp từ gói là đầu vào có mã băm kiểm lại được, nên nó phải đứng tên trong bản xuất:
        // người thứ ba chạy `sha256sum` trên chính gói đó là biết kết luận trail dựng trên byte nào.
        if (kho.Goi is not null)
            dauVao.Add(new DauVaoDaKiem($"Gói trail bằng chứng ({kho.Goi.TenFile})", kho.Goi.MaBamSha256));

        return dauVao;
    }

    private VerificationInput DuLieuVaoLoi(TransparencyReport report) =>
        new(report, danhMuc.DanhMuc, mocNeo.DaDoc, danhSach.DaDan, kho.DaDoc);

    private static string TenNguon(TransparencyReport report, string tenNguon) =>
        string.IsNullOrWhiteSpace(report.ProjectName) ? tenNguon : $"{report.ProjectName} — {tenNguon}";
}
