@* Lớp bằng chứng nằm ngoài cơ sở dữ liệu: các lô bản ghi được đẩy thẳng lên kho chỉ-ghi trong lúc
   lễ chạy. Vào trail bằng hai đường: đọc thẳng kho (có gọi mạng, nên phải do người kiểm bấm và
   phải nói trước gửi đi cái gì) hoặc nạp gói đã tải sẵn bằng script (không gọi mạng). *@
@using Noxh.XacMinh.Core.Kho
@inject TrangThaiKho trangThai

<section class="trail-bang-chung">
    <h2>Trail bằng chứng trên kho lưu trữ chỉ-ghi</h2>

    <p class="dan-nhap">
        Trong lúc lễ chạy, từng lô bản ghi (vé đã bốc, cam kết ngẫu nhiên, đầu chuỗi băm) được đẩy
        thẳng lên một kho lưu trữ mà máy chủ bốc thăm <strong>chỉ có quyền ghi thêm</strong> —
        chiếm được máy chủ hay cơ sở dữ liệu cũng không xoá được thứ đã lên kho. Đọc trail để xem
        các lô có móc xích liền nhau hay không, và để <strong>đối chiếu từng bản ghi trên kho với
        báo cáo minh bạch</strong>: bản đã lên kho không sửa lại được, nên báo cáo công bố sau mà
        khác đi là lộ ra ngay. Thứ <strong>chưa từng được đẩy lên kho</strong> thì không có trên trail;
        khi đó hạng mục tương ứng dừng ở CHƯA ĐỦ DỮ LIỆU, không kết luận thay.
        Đọc thẳng kho là bước <strong>gọi mạng tới kho</strong>: chỉ gửi đi địa chỉ kho bạn nhập (và
        chữ ký của khoá chỉ-đọc, nếu có) — <strong>không có dữ liệu nào của bạn rời khỏi máy này</strong>,
        và vẫn không hỏi máy chủ bốc thăm câu nào. Trình duyệt không gọi được kho (kho chưa bật CORS)
        thì dùng đường nạp gói ở dưới.
    </p>

    <div class="dia-chi-kho">
        <label>
            <span>Điểm cuối kho (theo thông báo của ban tổ chức)</span>
            <input type="url" spellcheck="false" placeholder="https://s3.vd-cloud.vn" @bind="diemCuoi"
                   @bind:event="oninput" />
        </label>
        <label>
            <span>Tên kho (bucket)</span>
            <input type="text" spellcheck="false" @bind="bucket" @bind:event="oninput" />
        </label>
        <label>
            <span>Tiền tố khoá object</span>
            <input type="text" spellcheck="false" @bind="tienTo" @bind:event="oninput" />
        </label>
        <label>
            <span>Vùng ký (region)</span>
            <input type="text" spellcheck="false" @bind="vung" @bind:event="oninput" />
        </label>
    </div>

    @* Không có công tắc chọn chế độ: dán khoá thì đọc bằng khoá, để trống thì đọc ẩn danh. Sau lễ
       kho mở công khai nên người dân cứ bấm đọc là xong, không phải hiểu thêm khái niệm nào. *@
    <p class="canh-bao-khoa" role="alert">
        <strong>Sau lễ kho mở công khai:</strong> không cần khoá, cứ bấm đọc.
        <strong>Trong lễ kho chưa mở</strong> nên cần khoá <strong>chỉ-đọc</strong> ban tổ chức cấp
        cho người kiểm — và chỉ khoá chỉ-đọc. Công cụ không ký nổi một request ghi (hàm ký chỉ ký
        GET) nên khoá có quyền ghi dán vào đây vừa vô dụng vừa mang khoá quan trọng đi lung tung.
        Khoá bạn dán <strong>chỉ nằm trong bộ nhớ của tab</strong>: không ghi đĩa, không cookie,
        không gửi đi đâu ngoài chính kho để ký request, đóng tab là mất.
    </p>

    @if (!trangThai.DaHieuCanhBao)
    {
        <button type="button" class="hieu-canh-bao" @onclick="() => trangThai.HieuCanhBao()">
            Tôi đã đọc cảnh báo, mở ô dán khoá chỉ-đọc
        </button>
    }
    else
    {
        <div class="o-dan-khoa-kho">
            <label>
                <span>Mã khoá truy cập</span>
                <input type="text" autocomplete="off" spellcheck="false" @bind="maKhoa"
                       @bind:event="oninput" />
            </label>
            <label>
                <span>Khoá bí mật</span>
                @* type=password + autocomplete=off: không để trình quản lý mật khẩu lưu lại khoá. *@
                <input type="password" autocomplete="off" spellcheck="false" @bind="biMat"
                       @bind:event="oninput" />
            </label>
            <label>
                <span>Thẻ phiên (nếu ban tổ chức cấp khoá tạm thời)</span>
                <input type="password" autocomplete="off" spellcheck="false" @bind="thePhien"
                       @bind:event="oninput" />
            </label>
        </div>
    }

    <button type="button" class="doc-trail" @onclick="Doc" disabled="@ChuaDuDeDoc">
        @(DangDoc ? "Đang đọc kho bằng chứng…" : "Đọc trail bằng chứng trên kho")
    </button>

    @* Trình duyệt chỉ đọc được kho khi chính kho bật CORS — thứ nằm ngoài tầm tay người kiểm. Nên
       phải có đường thứ hai: kho được tải sẵn bằng script rồi nạp vào đây. Đường này không gọi
       mạng, nhờ vậy bản offline cũng kiểm được trail. *@
    <details class="o-nap-goi">
        <summary>Kho chặn CORS, hoặc máy này không có mạng? Nạp gói trail đã tải sẵn</summary>

        <p class="dan-nhap">
            Gói trail là kho bằng chứng đã được tải sẵn bằng script <code>tai-goi-trail.py</code> (đi
            kèm mã nguồn công cụ, tổ giám sát chạy) rồi nén thành một file <code>.zip</code>: bên trong
            là <strong>nguyên văn</strong> các trang danh sách object của kho và <strong>byte thô</strong>
            của từng lô. Công cụ tự bóc danh sách và <strong>tự băm lại</strong> từng lô trong gói — mã
            băm không lấy theo lời khai của script, nên chuỗi móc xích vẫn do chính công cụ này kiểm.
            Nạp gói <strong>không gọi mạng</strong> và không cần khoá.
        </p>

        <p class="canh-bao-khoa" role="alert">
            Đường này <strong>yếu hơn đọc thẳng kho</strong>, và kết luận sẽ nói rõ điều đó: đọc thẳng
            thì chính trình duyệt của bạn chứng kiến các lô đang nằm trên kho, còn nạp gói thì mắt xích
            ấy do người chạy script gánh. Khi có thể, hãy <strong>tự chạy script trên máy bạn</strong>;
            và đối chiếu <code>sha256sum</code> của gói với mã băm in trong bản xuất kết quả.
        </p>

        <label class="o-tha-file o-tha-file-goi-trail">
            <InputFile OnChange="NhanGoi" accept=".zip,application/zip" />
            <span>Bấm chọn hoặc kéo thả gói trail (<code>.zip</code>) vào đây</span>
        </label>

        @if (loiGoi is not null)
        {
            <div class="thong-bao-loi" role="alert">@loiGoi</div>
        }
    </details>

    @if (trangThai.DaDoc is not null)
    {
        <button type="button" class="xoa-khoa" @onclick="Xoa">Xoá khoá và trail khỏi bộ nhớ</button>
    }

    <p class="ket-qua-doc-kho">@MoTa()</p>
</section>

@code {
    /// <summary>Đọc xong là dữ liệu vào lõi đã đổi — kết luận đang hiện phải được tính lại.</summary>
    [Parameter] public EventCallback DaDoi { get; set; }

    // 256 MB: trail cả buổi lễ nén lại chỉ vài MB; trần để file nhầm không treo tab người kiểm.
    private const long GioiHanByteGoi = 256L * 1024 * 1024;

    // Chỉ sống trong component, không đi vào bất kỳ nơi lưu trữ nào.
    private string diemCuoi = string.Empty;
    private string bucket = string.Empty;
    private string tienTo = "trail/";
    private string vung = "us-east-1";
    private string maKhoa = string.Empty;
    private string biMat = string.Empty;
    private string thePhien = string.Empty;
    private string? loiGoi;

    private bool DangDoc => trangThai.Buoc == BuocDocKho.DangDoc;

    private bool ChuaDuDeDoc =>
        DangDoc || string.IsNullOrWhiteSpace(diemCuoi) || string.IsNullOrWhiteSpace(bucket);

    private ThongSoKho ThongSo => new(diemCuoi.Trim(), bucket.Trim(), vung.Trim(), tienTo.Trim());

    private KhoaKho? Khoa => !string.IsNullOrWhiteSpace(maKhoa) && !string.IsNullOrWhiteSpace(biMat)
        ? new KhoaKho(maKhoa.Trim(), biMat.Trim(), string.IsNullOrWhiteSpace(thePhien) ? null : thePhien.Trim())
        : null;

    private async Task Doc()
    {
        await trangThai.Doc(ThongSo, Khoa);
        await DaDoi.InvokeAsync();
    }

    private async Task NhanGoi(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(GioiHanByteGoi);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            loiGoi = null;
            trangThai.NapGoi(buffer.ToArray(), file.Name);
        }
        catch (Exception ex)
        {
            // Không đọc nổi byte của file là lỗi nạp, chưa phải kết luận gì về trail.
            loiGoi = $"Không đọc được gói: {ex.Message}";
        }

        await DaDoi.InvokeAsync();
    }

    private async Task Xoa()
    {
        trangThai.Xoa();
        loiGoi = null;
        maKhoa = string.Empty;
        biMat = string.Empty;
        thePhien = string.Empty;
        await DaDoi.InvokeAsync();
    }

    private string MoTa()
    {
        if (trangThai.DaDoc is null)
            return trangThai.Buoc == BuocDocKho.DangDoc
                ? "— đang đọc kho"
                : "— chưa đọc kho bằng chứng lần nào trong phiên này";

        var kho = trangThai.DaDoc;

        // Nạp gói và đọc thẳng kho là hai việc khác nhau, nên đừng nói chung một chữ "đọc kho".
        var daNapGoi = trangThai.Goi is not null;

        if (kho.Loi is not null)
            return daNapGoi ? $"— gói nạp vào không dùng được: {kho.Loi}" : $"— đọc kho không được: {kho.Loi}";

        return $"— đã {(daNapGoi ? "nạp" : "đọc")} {kho.Lo.Count} lô ({kho.Lo.Sum(l => l.BanGhi.Count)} bản ghi) "
               + $"từ {kho.MoTaNguon}, "
               + $"{kho.MoTaCheDo}. Kết luận nằm ở các hạng mục trail phía trên.";
    }
}
