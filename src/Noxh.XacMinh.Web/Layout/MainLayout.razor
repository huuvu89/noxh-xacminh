@inherits LayoutComponentBase
@using Noxh.XacMinh.Web.BanDung
@inject ThongTinBanDung banDung

<main>
    @* Lỗi hiển thị không được nuốt cả trang: người dùng phải còn thấy được nút thử lại. *@
    <ErrorBoundary>
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <div class="thong-bao-loi" role="alert">
                Công cụ gặp lỗi ngoài dự kiến khi hiển thị kết quả. Hãy tải lại trang và nạp lại file
                JSON. Nếu lỗi vẫn còn, hãy kiểm tra file có đúng là báo cáo minh bạch tải từ trang công
                bố kết quả hay không.
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<ChanTrangBanDung ThongTin="banDung" />
