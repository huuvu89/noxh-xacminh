<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Lõi kiểm chứng thuần: không I/O, không mạng — vỏ UI nạp dữ liệu rồi đưa vào. -->
    <IsPackable>false</IsPackable>
    <!-- Số này đi thẳng vào mỗi bản xuất kết quả: nó nói bản công cụ nào đã ra kết luận đó. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Danh mục căn nhúng thẳng vào assembly: mở là chạy được, và bản offline không thiếu file.
         LogicalName ghi rõ để đổi tên thư mục không âm thầm làm mất tài nguyên. -->
    <EmbeddedResource Include="Units\apartment-units.json"
                      LogicalName="Noxh.XacMinh.Core.Units.apartment-units.json" />
  </ItemGroup>

</Project>
